{
  "name": "korean-parenting-mcp",
  "version": "0.2.0",
  "description": "한국 임신·출산·육아 정보 MCP 서버",
  "type": "module",
  "license": "MIT",
  "bin": {
    "korean-parenting-mcp": "build/index.js"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-assistant",
    "korea",
    "parenting",
    "pregnancy",
    "childcare"
  ],
  "author": "ok0",
  "homepage": "https://ok0.github.io/korean-parenting-mcp/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ok0/korean-parenting-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ok0/korean-parenting-mcp/issues"
  },
  "mcpName": "io.github.ok0/korean-parenting-mcp",
  "files": [
    "build",
    "!build/remote",
    "data",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('build',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.site.json --noEmit",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "build:scripts": "node -e \"require('node:fs').rmSync('build-scripts',{recursive:true,force:true})\" && tsc -p tsconfig.scripts.json",
    "build:site": "npm run build:scripts && node build-scripts/scripts/build-site.js",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run build && npm run build:scripts && npm run test",
    "visuals": "npm run build:scripts && node build-scripts/scripts/visuals/generate.js",
    "visuals:check": "npm run build:scripts && node build-scripts/scripts/visuals/generate.js --check",
    "readme:preview": "npm run build:scripts && node build-scripts/scripts/readme-preview.js",
    "compat:clients": "npm run build:scripts && node build-scripts/scripts/docs/client-compat.js",
    "smoke:pack": "npm run build && npm run build:scripts && node build-scripts/scripts/pack-smoke.js",
    "pack:mcpb": "npm run build && npm run build:scripts && node build-scripts/scripts/build-mcpb.js",
    "smoke:mcpb": "npm run build && npm run build:scripts && node build-scripts/scripts/mcpb-smoke.js",
    "smoke:remote": "npm run build && npm run build:scripts && node build-scripts/scripts/remote-smoke.js",
    "smoke:container": "npm run build:scripts && node build-scripts/scripts/container-smoke.js",
    "prepublishOnly": "npm run verify",
    "start": "node build/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fast-xml-parser": "^5.11.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "pdfjs-dist": "^6.4.299",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "tmp": "^0.2.6"
  }
}
