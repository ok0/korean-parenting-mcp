{
  "name": "korean-parenting-mcp",
  "version": "0.1.0",
  "description": "한국 임신·출산·육아 정보 MCP 서버 (비공식)",
  "type": "module",
  "license": "MIT",
  "bin": {
    "korean-parenting-mcp": "build/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "korea",
    "parenting",
    "pregnancy",
    "childcare"
  ],
  "author": "ok0",
  "files": [
    "build",
    "!build/remote",
    "data",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('build',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "build:scripts": "node -e \"require('node:fs').rmSync('build-scripts',{recursive:true,force:true})\" && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run build && npm run build:scripts && npm run test",
    "smoke:pack": "npm run build && npm run build:scripts && node build-scripts/scripts/pack-smoke.js",
    "pack:mcpb": "npm run build && npm run build:scripts && node build-scripts/scripts/build-mcpb.js",
    "smoke:mcpb": "npm run build && npm run build:scripts && node build-scripts/scripts/mcpb-smoke.js",
    "prepublishOnly": "npm run verify",
    "start": "node build/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fast-xml-parser": "^5.11.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "pdfjs-dist": "^4.10.38",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
